# Copy to .env and fill in. Not committed (.env is gitignored).

# Contact email sent to Crossref/OpenAlex as `mailto` so requests use their
# faster "polite pool" instead of the throttled anonymous one. Optional --
# both sources work without it, just with stricter rate limits.
NEWS_CONTACT_EMAIL=

# Reddit RSS credentials -- optional but strongly recommended. Without them
# Reddit rate-limits anonymous RSS to ~1 request/minute, so all subreddits
# are squeezed into one combined request (busy subreddits crowd out quiet
# ones). With them, each subreddit gets its own request, and the personal
# front page (`sources.reddit.front_page: true`) becomes available.
# Get both from the private feed URLs at https://www.reddit.com/prefs/feeds/
# (right-click any feed link -> copy link address):
#   https://www.reddit.com/.rss?feed=<REDDIT_RSS_FEED>&user=<REDDIT_RSS_USER>
# REDDIT_RSS_FEED is a credential (read access to your private feeds) --
# never commit or paste it anywhere. Regenerate it on that page if leaked.
REDDIT_RSS_USER=
REDDIT_RSS_FEED=
